parameters:
	doctrineCache: false
	encryptionKey: 'AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8='


# Konfigurace pro integrační testy – každý testovací proces má vlastní SQLite v paměti.
nettrine.dbal:
	debug:
		panel: false
	connections:
		default:
			driver: pdo_sqlite
			memory: true
			path: ':memory:'


services:
	aiClient: Tests\Support\FakeAiClient
	mailer: Tests\Support\FakeMailer
	clock:
		type: Psr\Clock\ClockInterface
		factory: Symfony\Component\Clock\MockClock('2026-11-16 10:00:00', 'Europe/Prague')
	security.passwords: Nette\Security\Passwords(::PASSWORD_BCRYPT, [cost: 4])
	security.userStorage: Tests\Support\MemoryUserStorage
	viteAssets: App\Core\Latte\ViteAssets(%rootDir%/tests/fixtures/vite-manifest.json)
	http.request: Nette\Http\Request(
		url: Nette\Http\UrlScript('http://konsel.test/', '/')
		headers: [sec-fetch-site: same-origin]
		remoteAddress: 127.0.0.1
	)
