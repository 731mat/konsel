services:
	- App\Core\Routing\RouterFactory::createRouter

	clock:
		type: Psr\Clock\ClockInterface
		factory: Symfony\Component\Clock\NativeClock('Europe/Prague')

	- App\Core\Tenancy\CurrentMunicipality
	- App\Core\Doctrine\TimestampableSubscriber
	- App\Core\Doctrine\MigrationsTableSchemaSubscriber
	- App\Core\Doctrine\DatabaseHealth
	- App\Model\Shared\DoctrineTransactionManager
	- App\Model\Storage\LocalFileStorage(%varDir%/storage)
	- App\Model\Backup\SqliteDatabaseDumper
	- App\Model\Backup\BackupFacade(backupDir: %varDir%/backups, storageDir: %varDir%/storage)
	- App\Core\Security\Authenticator
	- App\Core\Security\SecretBox(%encryptionKey%)
	- App\Core\Security\AuthorizatorFactory::create
	- App\Model\User\LoginThrottle
	- App\Model\Attachment\AttachmentPolicy(%attachmentMaxSize%)
	- App\Model\Shared\RichText\SymfonyHtmlSanitizer
	- App\Model\Document\MpdfRenderer(%tempDir%/mpdf)
	- App\Model\Document\DocumentTemplateEngine
	- App\Console\Demo\DemoSeeder(appUrl: %appUrl%)
	- App\Model\Mail\MailTemplates
	- App\Model\Resolution\ResolutionRecorder
	- App\Model\Search\SqliteFtsSearchIndex
	- App\Model\Search\DoctrineSearchSource
	- App\Model\Search\DoctrineSearchIndexSubscriber
	- App\Model\Audit\AuditContext
	- App\Model\Audit\DoctrineAuditSubscriber
	- App\Console\Demo\SeedDemoCommand(productionMode: %productionMode%)
	- App\UI\Form\FormFactory
	- App\UI\Sign\SignInFormFactory
	- App\UI\Menu\AdminMenuFactory
	- App\PortalModule\PortalSession

	httpClient:
		type: Symfony\Contracts\HttpClient\HttpClientInterface
		factory: Symfony\Component\HttpClient\HttpClient::create([timeout: 30])

	aiClient: App\Model\Ai\OpenAiClient
	aresClient: App\Model\Ares\RestAresClient
	mailer: App\Model\Mail\NetteMailer(from: %mailFrom%)
	viteAssets: App\Core\Latte\ViteAssets(%rootDir%/www/assets/.vite/manifest.json)
	- App\UI\Help\Wiki(%rootDir%/doc/wiki)

	# Server MCP pro AI asistenty – nástroje ApiModule/Mcp/Tool/*Tool se registrují samy (sekce search)
	- App\ApiModule\Mcp\McpServer
	- App\ApiModule\Mcp\McpToolRegistry(typed(App\ApiModule\Mcp\McpTool))


# Automatická registrace podle konvence adresářů
search:
	facades:
		in: %appDir%/Model
		classes: [*Facade]

	repositories:
		in: %appDir%/Model
		classes: [Doctrine*Repository]

	mcpTools:
		in: %appDir%/ApiModule/Mcp/Tool
		classes: [*Tool]

	commands:
		in: %appDir%/Console
		classes: [*Command]
		exclude:
			classes: [App\Console\Demo\SeedDemoCommand]
