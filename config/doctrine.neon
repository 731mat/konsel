parameters:
	# Perzistentní cache metadat jen v produkci (ve vývoji/testech by držela staré mapování).
	doctrineCache: %productionMode%


extensions:
	console: Contributte\Console\DI\ConsoleExtension(%consoleMode%)
	nettrine.dbal: Nettrine\DBAL\DI\DbalExtension
	nettrine.orm: Nettrine\ORM\DI\OrmExtension
	nettrine.migrations: Nettrine\Migrations\DI\MigrationsExtension


console:
	name: Konšel
	catchExceptions: true
	autoExit: true


nettrine.dbal:
	types:
		stored_file: App\Core\Doctrine\Type\StoredFileType
	debug:
		panel: %debugMode%
		sourcePaths: [%appDir%]
	connections:
		default:
			driver: pdo_sqlite
			path: %varDir%/database.sqlite
			middlewares:
				sqlitePragma: App\Core\Doctrine\SqlitePragmaMiddleware
			schemaAssetsFilter: App\Core\Doctrine\SchemaAssetsFilter


nettrine.orm:
	managers:
		default:
			connection: default
			lazyNativeObjects: true
			mapping:
				App:
					type: attributes
					directories: [%appDir%/Domain]
					namespace: App\Domain
			filters:
				tenant:
					class: App\Core\Tenancy\TenantFilter
					enabled: false
			defaultCache: App\Core\Doctrine\CacheFactory::create(%doctrineCache%, %tempDir%/cache/doctrine)


nettrine.migrations:
	table: doctrine_migrations
	customTemplate: %rootDir%/resources/migration.tpl
	directories:
		App\Migrations: %rootDir%/migrations
