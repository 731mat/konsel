parameters:
	# Šifrovací klíč aplikace (base64, 32 B) – nastavuje se v local.neon, vygeneruje: make console ARGS="app:encryption-key"
	encryptionKey: ''


application:
	errorPresenter:
		4xx: Error:Error4xx
		5xx: Error:Error5xx
	mapping: App\*Module\**Presenter


latte:
	strictTypes: yes
	strictParsing: yes
	extensions:
		- App\Core\Latte\LatteExtension


session:
	expiration: 14 days
	cookieSamesite: Lax
	cookieSecure: auto
	name: konsel_sid


security:
	authentication:
		storage: session
		expiration: 60 minutes


di:
	export:
		parameters: no
		tags: no
