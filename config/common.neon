parameters:


application:
	errorPresenter:
		4xx: Error:Error4xx
		5xx: Error:Error5xx
	mapping: App\Presentation\*\**Presenter


latte:
	strictTypes: yes
	strictParsing: yes
	extensions:
		- App\Core\Latte\LatteExtension


session:
	expiration: 14 days
	cookieSamesite: Lax
	cookieSecure: auto
	name: konsel_sid


security:
	authentication:
		storage: session
		expiration: 60 minutes


di:
	export:
		parameters: no
		tags: no
