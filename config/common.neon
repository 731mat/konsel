parameters:
	# Šifrovací klíč aplikace (base64, 32 B) – nastavuje se v local.neon, vygeneruje: make console ARGS="app:encryption-key"
	encryptionKey: ''
	# Maximální velikost jedné přílohy (bajty); u běžného nahrávání omezuje i upload_max_filesize v php.ini
	attachmentMaxSize: 67108864
	# Veřejná adresa aplikace (odkazy v e-mailech z konzole, např. demo data)
	appUrl: 'http://localhost:8080'
	# Odesílatel e-mailů (jméno odesílatele je obec); v produkci přepsat v local.neon
	mailFrom: 'noreply@konsel.matyho.cz'
	# SMTP – výchozí je Mailpit z docker compose; v produkci přepsat v local.neon
	smtp:
		host: mailpit
		port: 1025
		username: ''
		password: ''
		encryption: null


application:
	errorPresenter:
		4xx: Error:Error4xx
		5xx: Error:Error5xx
	mapping: App\*Module\**Presenter


latte:
	strictTypes: yes
	strictParsing: yes
	extensions:
		- App\Core\Latte\LatteExtension


mail:
	smtp: true
	host: %smtp.host%
	port: %smtp.port%
	username: %smtp.username%
	password: %smtp.password%
	encryption: %smtp.encryption%
	timeout: 15


# Příznak Secure u cookies řídí http.cookieSecure (výchozí auto = podle HTTPS). V sekci session by 'auto' znamenalo vždy true.
session:
	expiration: 14 days
	cookieSamesite: Lax
	name: konsel_sid


security:
	authentication:
		storage: session
		expiration: 60 minutes


di:
	export:
		parameters: no
		tags: no
