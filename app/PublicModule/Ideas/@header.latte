{parameters App\Model\Municipality\Municipality $municipality}
<header class="d-flex align-items-center gap-3 mb-4">
	<span class="sidebar-municipality-icon" style="width: 3rem; height: 3rem; font-size: 1.4rem; display: grid; place-items: center; border-radius: .75rem; background: var(--bs-primary-bg-subtle); color: var(--bs-primary-text-emphasis)"><i class="bi bi-bank" aria-hidden="true"></i></span>
	<div>
		<div class="fw-bold fs-5">{$municipality->getProfile()->officialName}</div>
		<div class="text-body-secondary small">Podněty a plány obce</div>
	</div>
</header>
