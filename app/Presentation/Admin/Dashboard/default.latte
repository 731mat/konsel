{block title}Přehled{/block}

{block content}
{varType bool $showMeetings}
{varType App\Domain\Meeting\Meeting[] $upcoming}
{varType App\Domain\Meeting\Meeting[] $recent}
{varType bool $canCreateMeeting}

<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
	<div class="me-auto">
		<h1 class="h3 mb-0">Přehled</h1>
		<p class="text-body-secondary mb-0">{$user->getIdentity()?->getData()['name'] ?? ''}{if $currentMunicipality} · {$currentMunicipality->getName()}{/if}</p>
	</div>
	<a n:if="$showMeetings && $canCreateMeeting" n:href="Meeting:add" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nové zasedání</a>
</div>

{if $showMeetings}
<div class="row g-4">
	<div class="col-xl-6">
		<div class="card h-100">
			<div class="card-header fw-semibold"><i class="bi bi-calendar-event" aria-hidden="true"></i> Připravovaná zasedání</div>
			<div class="list-group list-group-flush">
				<a n:foreach="$upcoming as $meeting" n:href="Meeting:detail, id: $meeting->getId()" class="list-group-item list-group-item-action d-flex align-items-center gap-3">
					<div class="text-center lh-1 meeting-date">
						<div class="fs-4 fw-semibold">{$meeting->getScheduledAt()->format('j')}</div>
						<div class="small text-body-secondary">{$meeting->getScheduledAt()->format('n/Y')}</div>
					</div>
					<div class="me-auto">
						<div class="fw-semibold">{$meeting->getTitle()}</div>
						<div class="small text-body-secondary">{$meeting->getBody()->getName()} · {$meeting->getScheduledAt()->format('H:i')} · {$meeting->getPlace()}</div>
					</div>
					{include '../Meeting/@status.latte', status: $meeting->getStatus()}
				</a>
				<div n:if="!$upcoming" class="list-group-item text-body-secondary">Žádné zasedání se nepřipravuje.</div>
			</div>
		</div>
	</div>
	<div class="col-xl-6">
		<div class="card h-100">
			<div class="card-header fw-semibold"><i class="bi bi-clock-history" aria-hidden="true"></i> Poslední zasedání</div>
			<div class="list-group list-group-flush">
				<a n:foreach="$recent as $meeting" n:href="Meeting:detail, id: $meeting->getId()" class="list-group-item list-group-item-action d-flex align-items-center gap-3">
					<div class="me-auto">
						<div class="fw-semibold">{$meeting->getTitle()}</div>
						<div class="small text-body-secondary">{$meeting->getBody()->getName()} · {$meeting->getScheduledAt()|czDate}</div>
					</div>
					{include '../Meeting/@status.latte', status: $meeting->getStatus()}
				</a>
				<div n:if="!$recent" class="list-group-item text-body-secondary">Zatím neproběhlo žádné zasedání.</div>
			</div>
		</div>
	</div>
</div>
{/if}
