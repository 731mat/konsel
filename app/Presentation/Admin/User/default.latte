{block title}Uživatelé{/block}

{block breadcrumbs}
	<li class="breadcrumb-item active" aria-current="page">Uživatelé</li>
{/block}

{block content}
{varType App\Domain\User\User[] $users}
{varType int $currentUserId}
<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
	<h1 class="h3 mb-0 me-auto">Uživatelé úřadu</h1>
	<a n:href="add" class="btn btn-primary"><i class="bi bi-person-plus" aria-hidden="true"></i> Nový uživatel</a>
</div>

<div class="card">
	<div class="table-responsive">
		<table class="table table-hover align-middle mb-0">
			<thead><tr><th>Jméno</th><th>E-mail</th><th>Role</th><th>Poslední přihlášení</th><th class="text-end">Akce</th></tr></thead>
			<tbody>
				<tr n:foreach="$users as $u" n:class="!$u->isActive() ? text-body-secondary">
					<td>
						{$u->getName()}
						<span n:if="!$u->isActive()" class="badge text-bg-secondary">deaktivován</span>
						<span n:if="$u->mustChangePassword()" class="badge text-bg-warning">dočasné heslo</span>
					</td>
					<td>{$u->getEmail()}</td>
					<td>{$u->getRole()->label()}</td>
					<td>{$u->getLastLoginAt()|czDateTime}</td>
					<td class="text-end text-nowrap">
						<a n:href="edit, id: $u->getId()" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil" aria-hidden="true"></i> Upravit</a>
						{if $u->getId() !== $currentUserId}
							<form method="post" action="{link resetPassword!, id: $u->getId()}" class="d-inline">
								<button type="submit" class="btn btn-sm btn-outline-secondary" data-confirm="Vygenerovat nové dočasné heslo pro {$u->getName()}?" title="Reset hesla"><i class="bi bi-key" aria-hidden="true"></i></button>
							</form>
							<form n:if="$u->isActive()" method="post" action="{link deactivate!, id: $u->getId()}" class="d-inline">
								<button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Deaktivovat účet {$u->getName()}?" title="Deaktivovat"><i class="bi bi-person-slash" aria-hidden="true"></i></button>
							</form>
							<form n:if="!$u->isActive()" method="post" action="{link activate!, id: $u->getId()}" class="d-inline">
								<button type="submit" class="btn btn-sm btn-outline-success" title="Aktivovat"><i class="bi bi-person-check" aria-hidden="true"></i></button>
							</form>
						{/if}
					</td>
				</tr>
			</tbody>
		</table>
	</div>
</div>
