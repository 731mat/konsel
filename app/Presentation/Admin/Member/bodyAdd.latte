{block title}Nový orgán{/block}

{block breadcrumbs}
	<li class="breadcrumb-item"><a n:href="default">Osoby a orgány</a></li>
	<li class="breadcrumb-item active" aria-current="page">Nový orgán</li>
{/block}

{block content}
{varType App\Domain\People\Term $term}
<h1 class="h3 mb-1">Nový orgán</h1>
<p class="text-body-secondary mb-4">Volební období {$term->getName()}</p>
<div class="card" style="max-width: 40rem"><div class="card-body">{control bodyForm}</div></div>
