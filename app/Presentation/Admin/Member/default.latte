{block title}Osoby a orgány{/block}

{block breadcrumbs}
	<li class="breadcrumb-item active" aria-current="page">Osoby a orgány</li>
{/block}

{block content}
{varType App\Domain\People\Term[] $terms}
{varType App\Domain\People\Term|null $selectedTerm}
{varType App\Domain\People\Body[] $bodies}
{varType string[] $warnings}
{varType DateTimeImmutable $today}
{varType bool $canEdit}

<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
	<h1 class="h3 mb-0 me-auto">Osoby a orgány</h1>
	<a n:href="Person:" class="btn btn-outline-secondary"><i class="bi bi-people" aria-hidden="true"></i> Osoby</a>
	<a n:if="$canEdit" n:href="termAdd" class="btn btn-outline-secondary"><i class="bi bi-calendar-plus" aria-hidden="true"></i> Volební období</a>
	<a n:if="$canEdit && $selectedTerm" n:href="bodyAdd, term: $selectedTerm->getId()" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nový orgán</a>
</div>

{if !$selectedTerm}
	<div class="card">
		<div class="card-body">
			<h2 class="h5">Začněte volebním obdobím</h2>
			<p class="text-body-secondary">Orgány obce (zastupitelstvo, rada, výbory) se zakládají vždy pro konkrétní volební období.</p>
			<a n:if="$canEdit" n:href="termAdd" class="btn btn-primary">Založit volební období</a>
		</div>
	</div>
{else}
	<ul n:if="count($terms) > 1" class="nav nav-tabs mb-3">
		<li n:foreach="$terms as $term" class="nav-item">
			<a n:href="default, term: $term->getId()" n:class="nav-link, $term === $selectedTerm ? active">{$term->getName()}</a>
		</li>
	</ul>

	<p class="text-body-secondary">
		Volební období <strong>{$selectedTerm->getName()}</strong>
		({$selectedTerm->getStartsOn()|czDate} – {$selectedTerm->getEndsOn()|czDate})
	</p>

	<div n:if="$warnings" class="alert alert-warning">
		<i class="bi bi-exclamation-triangle" aria-hidden="true"></i> <strong>Upozornění</strong>
		<ul class="mb-0 mt-1">
			<li n:foreach="$warnings as $warning">{$warning}</li>
		</ul>
	</div>

	{if !$bodies}
		<div class="card"><div class="card-body text-body-secondary">V tomto volebním období zatím nejsou žádné orgány.</div></div>
	{/if}

	<div class="row g-3">
		<div n:foreach="$bodies as $body" class="col-xl-6">
			<div class="card h-100">
				<div class="card-header d-flex align-items-center gap-2">
					<span class="badge text-bg-secondary">{$body->getType()->label()}</span>
					<a n:href="body, id: $body->getId()" class="fw-semibold me-auto">{$body->getName()}</a>
					{var $members = $body->getMembersAt($today)}
					<span class="text-body-secondary small">{count($members)} / {$body->getSeatCount()}</span>
				</div>
				<ul class="list-group list-group-flush">
					<li n:foreach="$members as $membership" class="list-group-item d-flex justify-content-between">
						<span>{$membership->getPerson()->getFullName()}</span>
						<span class="text-body-secondary small">{$membership->getFunction()->label()}</span>
					</li>
					<li n:if="!$members" class="list-group-item text-body-secondary">Bez členů</li>
				</ul>
			</div>
		</div>
	</div>
{/if}
