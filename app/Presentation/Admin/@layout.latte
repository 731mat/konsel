{layout '../@layout.latte'}

{block body}
<nav class="navbar bg-body border-bottom sticky-top">
	<div class="container-fluid gap-2">
		<button class="navbar-toggler d-lg-none border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Otevřít menu">
			<span class="navbar-toggler-icon"></span>
		</button>
		<a class="navbar-brand brand-mark" n:href=":Admin:Dashboard:">Konšel</a>
		<span class="navbar-text me-auto text-truncate" n:ifcontent>{$currentMunicipality?->getName()}</span>

		<div class="dropdown">
			<button class="btn btn-link text-body text-decoration-none dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
				<i class="bi bi-person-circle" aria-hidden="true"></i>
				<span class="d-none d-sm-inline">{$user->getIdentity()?->getData()['name'] ?? ''}</span>
			</button>
			<ul class="dropdown-menu dropdown-menu-end">
				<li><a class="dropdown-item" n:href=":Sign:out"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Odhlásit se</a></li>
			</ul>
		</div>
	</div>
</nav>

<div class="d-lg-flex">
	<aside class="app-sidebar offcanvas-lg offcanvas-start bg-body" id="appSidebar" tabindex="-1" aria-label="Hlavní menu">
		<div class="offcanvas-header">
			<span class="offcanvas-title brand-mark">Konšel</span>
			<button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Zavřít menu"></button>
		</div>
		<div class="offcanvas-body p-3">
			{control adminMenu}
		</div>
	</aside>

	<main class="app-main flex-grow-1 p-3 p-lg-4">
		<nav aria-label="Drobečková navigace" n:ifcontent>
			<ol class="breadcrumb" n:ifcontent>{ifset breadcrumbs}{include breadcrumbs}{/ifset}</ol>
		</nav>

		{snippet flashes}{include flashes}{/snippet}

		{include content}
	</main>
</div>
{/block}
