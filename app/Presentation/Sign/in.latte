{block title}Přihlášení{/block}

{block content}
<main class="sign-in-card mx-auto mt-lg-5">
	<div class="text-center mb-4">
		<h1 class="h3 brand-mark mb-1">Konšel</h1>
		<p class="text-body-secondary">Přihlášení pro pracovníky úřadu</p>
	</div>

	<div class="card shadow-sm">
		<div class="card-body p-4">
			{control signInForm}
		</div>
	</div>
</main>
