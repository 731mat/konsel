{layout '../../@layout.latte'}
{block title}Neplatný odkaz{/block}

{block content}
<main class="sign-in-card m-auto py-4 text-center">
	<div class="brand fs-3 mb-4">{include '../../UI/@logo.latte'} Konšel</div>
	<div class="card shadow-sm">
		<div class="card-body p-4">
			<i class="bi bi-link-45deg fs-1 text-body-secondary d-block mb-2" aria-hidden="true"></i>
			<h1 class="h5">Odkaz je neplatný nebo vypršel</h1>
			<p class="text-body-secondary mb-0">Každý odkaz na podklady je osobní a platí jen omezenou dobu. Požádejte obecní úřad o nový odkaz.</p>
		</div>
	</div>
</main>