{layout '../../@layout.latte'}
{block title}Odhlášeno{/block}

{block content}
<main class="sign-in-card m-auto py-4 text-center">
	<div class="brand fs-3 mb-4">{include '../../UI/@logo.latte'} Konšel</div>
	<div class="card shadow-sm">
		<div class="card-body p-4">
			<i class="bi bi-check-circle fs-1 text-success d-block mb-2" aria-hidden="true"></i>
			<h1 class="h5">Byli jste odhlášeni</h1>
			<p class="text-body-secondary mb-0">K podkladům se vrátíte znovu kliknutím na odkaz z pozvánky.</p>
		</div>
	</div>
</main>