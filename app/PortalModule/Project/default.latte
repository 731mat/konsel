{block title}Plány{/block}

{block content}
{varType App\Model\Project\Project[] $projects}
<h1 class="h3 mb-1">Plány obce</h1>
<p class="text-body-secondary">Rozpracované plány a záměry. U každého můžete diskutovat a přikládat soubory.</p>
<div class="row g-3">
	<div n:foreach="$projects as $project" class="col-md-6">
		<a n:href="detail, id: $project->getId()" class="card h-100 project-card text-reset">
			<div class="card-body">
				<div class="d-flex flex-wrap gap-1 mb-2">{include '../../AdminModule/Project/@badges.latte', project: $project}</div>
				<h2 class="h6 mb-1">{$project->getTitle()}</h2>
				<p n:if="$project->getDescription()" class="small text-body-secondary mb-0">{$project->getDescription()|truncate: 140}</p>
			</div>
		</a>
	</div>
</div>
<div n:if="!$projects" class="card"><div class="card-body empty-state"><i class="bi bi-kanban" aria-hidden="true"></i>Žádné rozpracované plány.</div></div>
