{block title}Přehled{/block}

{block content}
{varType bool $showMeetings}
{varType App\Model\Meeting\Meeting|null $next}
{varType string|null $nextIn}
{varType App\Model\Meeting\Meeting[] $upcoming}
{varType App\Model\Meeting\Meeting[] $recent}
{varType App\Model\Resolution\ResolutionTask[] $tasks}
{varType int $overdueCount}
{varType Closure $isOverdue}
{varType bool $canCreateMeeting}

<div class="d-flex flex-wrap align-items-center gap-3 mb-4">
	<div class="me-auto">
		<h1 class="h3 mb-1">Dobrý den, {$user->getIdentity()?->getData()['name'] ?? ''}</h1>
		<p class="text-body-secondary mb-0" n:ifcontent>{$currentMunicipality?->getProfile()->officialName}</p>
	</div>
	<a n:if="$showMeetings && $canCreateMeeting" n:href="Meeting:add" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> Nové zasedání</a>
</div>

{if $showMeetings}
	{if $next}
		<div class="card next-meeting mb-4">
			<div class="card-body p-4 d-flex flex-wrap align-items-center gap-4">
				{include '../Meeting/@dateTile.latte', date: $next->getScheduledAt()}
				<div class="me-auto">
					<div class="small text-uppercase fw-semibold text-white-75 mb-1" style="letter-spacing: .06em">Nejbližší zasedání · {$nextIn}</div>
					<h2 class="h4 mb-1"><a n:href="Meeting:detail, id: $next->getId()" class="stretched-link">{$next->getTitle()}</a></h2>
					<div class="text-white-75">
						{$next->getBody()->getName()}
						· <i class="bi bi-clock" aria-hidden="true"></i> {$next->getScheduledAt()->format('H:i')}
						· <i class="bi bi-geo-alt" aria-hidden="true"></i> {$next->getPlace()}
					</div>
				</div>
				<span class="badge rounded-pill text-bg-light fs-6 fw-semibold">{$next->getStatus()->label()}</span>
			</div>
		</div>
	{/if}

	<div class="row g-4">
		<div class="col-xl-6">
			<div class="card h-100">
				<div class="card-header"><i class="bi bi-calendar-event text-primary me-1" aria-hidden="true"></i> Připravovaná zasedání</div>
				<div class="list-group list-group-flush">
					<a n:foreach="$upcoming as $meeting" n:href="Meeting:detail, id: $meeting->getId()" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
						{include '../Meeting/@dateTile.latte', date: $meeting->getScheduledAt()}
						<div class="me-auto">
							<div class="fw-semibold">{$meeting->getTitle()}</div>
							<div class="small text-body-secondary">{$meeting->getBody()->getName()} · {$meeting->getScheduledAt()->format('H:i')}</div>
						</div>
						{include '../Meeting/@status.latte', status: $meeting->getStatus()}
					</a>
					<div n:if="!$upcoming" class="list-group-item empty-state border-0">
						<i class="bi bi-calendar2-check" aria-hidden="true"></i>
						{if $next}Další zasedání zatím nejsou naplánovaná.{else}Žádné zasedání se nepřipravuje.{/if}
					</div>
				</div>
			</div>
		</div>
		<div class="col-xl-6">
			<div class="card h-100">
				<div class="card-header"><i class="bi bi-clock-history text-primary me-1" aria-hidden="true"></i> Poslední zasedání</div>
				<div class="list-group list-group-flush">
					<a n:foreach="$recent as $meeting" n:href="Meeting:detail, id: $meeting->getId()" class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
						{include '../Meeting/@dateTile.latte', date: $meeting->getScheduledAt(), muted: true}
						<div class="me-auto">
							<div class="fw-semibold">{$meeting->getTitle()}</div>
							<div class="small text-body-secondary">{$meeting->getBody()->getName()}</div>
						</div>
						{include '../Meeting/@status.latte', status: $meeting->getStatus()}
					</a>
					<div n:if="!$recent" class="list-group-item empty-state border-0">
						<i class="bi bi-archive" aria-hidden="true"></i>
						Zatím neproběhlo žádné zasedání.
					</div>
				</div>
			</div>
		</div>
	</div>
{/if}

<div n:if="$tasks || $overdueCount" class="card mt-4">
	<div class="card-header d-flex align-items-center">
		<span class="me-auto"><i class="bi bi-check2-square text-primary me-1" aria-hidden="true"></i> Úkoly z usnesení</span>
		<span n:if="$overdueCount" class="badge bg-danger-subtle text-danger-emphasis me-2">{$overdueCount} po termínu</span>
		<a n:href="Task:default" class="small">Všechny úkoly</a>
	</div>
	<ul class="list-group list-group-flush">
		<li n:foreach="$tasks as $task" n:class="list-group-item, task-row, $isOverdue($task) ? task-overdue">
			<div class="min-w-0">
				<a n:href="Resolution:detail#ukoly, id: $task->getResolution()->getId()" class="fw-semibold text-reset">{$task->getDescription()}</a>
				<div class="small text-body-secondary">{$task->getAssignee()?->getFullName() ?? 'obecní úřad'} · usnesení č. {$task->getResolution()->getNumber()}</div>
			</div>
			<span n:class="small, text-nowrap, $isOverdue($task) ? 'text-danger fw-semibold' : 'text-body-secondary'">{$task->getDueDate() ? ($task->getDueDate()|czDate) : 'bez termínu'}</span>
			<span></span>
		</li>
	</ul>
</div>
