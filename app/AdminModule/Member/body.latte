{block title}{$body->getName()}{/block}

{block breadcrumbs}
	<li class="breadcrumb-item"><a n:href="default, term: $body->getTerm()->getId()">Osoby a orgány</a></li>
	<li class="breadcrumb-item active" aria-current="page">{$body->getName()}</li>
{/block}

{block content}
{varType App\Model\People\Body $body}
{varType DateTimeImmutable $today}
{varType bool $canEdit}

<div class="d-flex flex-wrap align-items-center gap-2 mb-1">
	<h1 class="h3 mb-0 me-auto">{$body->getName()}</h1>
	<a n:if="$canEdit" n:href="bodyEdit, id: $body->getId()" class="btn btn-outline-secondary"><i class="bi bi-pencil" aria-hidden="true"></i> Upravit</a>
</div>
<p class="text-body-secondary mb-4">
	{$body->getType()->label()} · volební období {$body->getTerm()->getName()} · {$body->getSeatCount()} míst · číslování usnesení <code>{$body->getNumberingMask()}</code>
</p>

<div class="row g-4">
	<div class="col-xl-8">
		<div class="card">
			<div class="card-header fw-semibold">Členové</div>
			<div class="table-responsive">
				<table class="table align-middle mb-0">
					<thead><tr><th>Jméno</th><th>Funkce</th><th>Od</th><th>Do</th><th n:if="$canEdit"></th></tr></thead>
					<tbody>
						<tr n:foreach="$body->getMemberships() as $membership" n:class="!$membership->isActiveAt($today) ? text-body-secondary">
							<td>{$membership->getPerson()->getFullName()}</td>
							<td>{$membership->getFunction()->label()}</td>
							<td>{$membership->getValidFrom()|czDate}</td>
							<td>{$membership->getValidTo()|czDate}</td>
							<td n:if="$canEdit" class="text-end text-nowrap">
								<a n:if="$membership->getValidTo() === null" n:href="endMembership, id: $body->getId(), membershipId: $membership->getId()" class="btn btn-sm btn-outline-secondary">Ukončit</a>
								<form method="post" action="{link removeMembership!, membershipId: $membership->getId()}" class="d-inline">
									<button type="submit" class="btn btn-sm btn-outline-danger" title="Smazat chybný záznam" data-confirm="Smazat záznam o členství? Použijte jen pro opravu chyby – odchod člena se řeší ukončením."><i class="bi bi-trash" aria-hidden="true"></i></button>
								</form>
							</td>
						</tr>
						<tr n:if="!$body->getMemberships()"><td colspan="5" class="text-body-secondary">Orgán zatím nemá členy.</td></tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<div n:if="$canEdit" class="col-xl-4">
		<div class="card">
			<div class="card-header fw-semibold">Přidat člena</div>
			<div class="card-body">
				{control memberForm}
				<p class="small text-body-secondary mb-0">Osoba v seznamu chybí? <a n:href="Person:add">Přidejte ji</a>.</p>
			</div>
		</div>
	</div>
</div>
