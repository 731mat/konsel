{block title}Průběh – {$meeting->getTitle()}{/block}

{block breadcrumbs}
	<li class="breadcrumb-item"><a n:href="Meeting:default">Zasedání</a></li>
	<li class="breadcrumb-item"><a n:href="Meeting:detail, id: $meeting->getId()">{$meeting->getTitle()}</a></li>
	<li class="breadcrumb-item active" aria-current="page">Průběh</li>
{/block}

{block content}
{varType App\Model\Meeting\Meeting $meeting}
{varType App\Model\Meeting\AttendanceOverview $attendance}
{varType bool $canRecord}
{varType App\Model\Meeting\AttendanceStatus[] $choices}
{varType App\Model\Meeting\MeetingTransition[] $transitions}
{varType App\Model\Meeting\AgendaItem[] $items}
{varType array<int, list<App\Model\Meeting\VotingRound>> $rounds}
{varType Closure $voters}
{varType bool $canVote}
{varType bool $canCorrect}
{varType App\Model\Meeting\VoteChoice[] $voteChoices}
{varType App\Model\Meeting\VotingType[] $otherVotingTypes}
{varType App\Model\People\Person[] $candidates}

<div class="proceedings-header d-flex flex-wrap align-items-center gap-3 mb-4">
	<div class="me-auto">
		<h1 class="h3 mb-1">
			Průběh zasedání
			<span class="fs-6 align-middle">{include '../Meeting/@status.latte', status: $meeting->getStatus()}</span>
		</h1>
		<p class="text-body-secondary mb-0">
			{$meeting->getTitle()} · {$meeting->getBody()->getName()} · {$meeting->getScheduledAt()|czDateTime}
			{if $meeting->getStartedAt()} · zahájeno {$meeting->getStartedAt()->format('G:i')}{/if}
			{if $meeting->getEndedAt()} · ukončeno {$meeting->getEndedAt()->format('G:i')}{/if}
		</p>
	</div>

	{snippet quorum}
		{var $quorum = $attendance->quorum}
		<div n:class="quorum-indicator, $quorum->isReached() ? quorum-ok : quorum-missing" role="status" aria-live="polite">
			<i n:class="bi, $quorum->isReached() ? bi-check-circle-fill : bi-exclamation-octagon-fill" aria-hidden="true"></i>
			<div>
				<div class="fw-semibold">{$quorum->isReached() ? 'Usnášeníschopné' : 'Není usnášeníschopné'}</div>
				<div class="small">přítomno {$quorum->present} z {$quorum->members}{if !$quorum->isReached()}, chybí {$quorum->missing()}{else}, potřeba {$quorum->required}{/if}</div>
			</div>
		</div>
	{/snippet}

	<div n:if="$transitions" class="d-flex gap-2">
		<form n:foreach="$transitions as $transition" method="post" action="{link transition!, transition: $transition->value}">
			<button type="submit" class="btn btn-primary" data-confirm={$transition->value === 'close' ? 'Ukončit zasedání?' : null}>{$transition->label()}</button>
		</form>
	</div>
</div>

<div n:if="$meeting->getStatus() === App\Model\Meeting\MeetingStatus::Draft" class="alert alert-light border">
	<i class="bi bi-info-circle" aria-hidden="true"></i> Zasedání je v přípravě. Docházku půjde zapisovat po sdílení se zastupiteli.
</div>

{snippet attendance}
<div class="card mb-4" id="dochazka">
	<div class="card-header d-flex flex-wrap align-items-center gap-2">
		<span class="me-auto"><i class="bi bi-people" aria-hidden="true"></i> Docházka</span>
		<span class="small text-body-secondary">
			<span class="text-success-emphasis">{$attendance->count(App\Model\Meeting\AttendanceStatus::Present)} přítomno</span>
			· {$attendance->count(App\Model\Meeting\AttendanceStatus::Excused)} omluveno
			· {$attendance->count(App\Model\Meeting\AttendanceStatus::Absent)} neomluveno
			{if !$attendance->isComplete()} · <strong>{$attendance->count(App\Model\Meeting\AttendanceStatus::Unknown)} nezapsáno</strong>{/if}
		</span>
		<form n:if="$canRecord && !$attendance->isComplete()" method="post" action="{link allPresent!}" class="ajax">
			<button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check2-all" aria-hidden="true"></i> Ostatní přítomni</button>
		</form>
	</div>

	{if $attendance->entries}
		<ul class="list-group list-group-flush attendance-list">
			<li n:foreach="$attendance->entries as $entry" class="list-group-item attendance-row">
				{var $status = $entry->getStatus()}
				{var $record = $entry->attendance}
				<div class="attendance-person">
					<span n:class="attendance-dot, 'bg-' . $status->tone()" aria-hidden="true"></span>
					<div class="min-w-0">
						<div class="fw-semibold text-truncate">{$entry->person->getFullName()}</div>
						<div class="small text-body-secondary">
							{$entry->function?->label() ?? 'mimo orgán'}
							{if $record?->getArrivedAt()} · příchod {$record->getArrivedAt()->format('G:i')}{/if}
							{if $record?->getLeftAt()} · <span class="text-danger-emphasis">odešel {$record->getLeftAt()->format('G:i')}</span>{/if}
						</div>
					</div>
				</div>

				{if $canRecord}
					<form method="post" action="{link mark!, personId: $entry->person->getId()}" class="ajax attendance-choices" role="group" aria-label="Docházka: {$entry->person->getFullName()}">
						<button n:foreach="$choices as $choice" type="submit" name="status" value="{$choice->value}"
							n:class="btn, btn-sm, $choice === $status ? 'btn-' . $choice->tone() : btn-outline-secondary"
							aria-pressed="{$choice === $status ? 'true' : 'false'}">{$choice->label()|firstUpper}</button>
					</form>
					<div class="attendance-extra">
						{if $status === App\Model\Meeting\AttendanceStatus::Present && $meeting->getStatus() === App\Model\Meeting\MeetingStatus::InProgress}
							{if $entry->hasLeft()}
								<form method="post" action="{link return!, personId: $entry->person->getId()}" class="ajax">
									<button type="submit" class="btn btn-sm btn-link text-decoration-none px-0"><i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Vrátil se</button>
								</form>
							{else}
								<form method="post" action="{link leave!, personId: $entry->person->getId()}" class="ajax">
									<button type="submit" class="btn btn-sm btn-link text-decoration-none px-0 text-body-secondary"><i class="bi bi-box-arrow-right" aria-hidden="true"></i> Odešel</button>
								</form>
							{/if}
						{/if}
					</div>
				{else}
					<span n:class="badge, status-badge, 'bg-' . $status->tone() . '-subtle', 'text-' . $status->tone() . '-emphasis'">{$status->label()}{if $entry->hasLeft()}, odešel{/if}</span>
				{/if}
			</li>
		</ul>
	{else}
		<div class="card-body empty-state"><i class="bi bi-people" aria-hidden="true"></i>Orgán nemá k datu zasedání žádné členy. Doplňte je v Osobách a orgánech.</div>
	{/if}
	<div class="card-footer bg-transparent small text-body-secondary">
		Usnášeníschopnost: přítomna nadpoloviční většina všech {$attendance->quorum->members} členů orgánu, tj. alespoň {$attendance->quorum->required} (§ 92 zákona o obcích).
		Přítomnost zapsaná po zahájení se zaznamená jako pozdní příchod.
	</div>
</div>
{/snippet}

{snippet agenda}
<div class="d-flex align-items-center mb-3" id="program">
	<h2 class="h5 mb-0 me-auto">Program a hlasování</h2>
	<span n:if="!$canVote && $meeting->getStatus()->isPlanning()" class="small text-body-secondary">Hlasovat půjde po zahájení zasedání.</span>
</div>

{foreach $items as $item}
	{var $itemRounds = $rounds[$item->getId()] ?? []}
	{var $openRound = null}
	{var $decided = false}
	{foreach $itemRounds as $round}
		{if $round->isOpen()}{var $openRound = $round}{/if}
		{if !$round->isOpen() && $round->getType()->decidesItem() && $round->getResult() === App\Model\Meeting\VotingResult::Adopted}{var $decided = true}{/if}
	{/foreach}
	<section class="card proceedings-item mb-3" id="bod-{$item->getId()}">
		<div class="card-header d-flex align-items-center gap-2">
			<span class="agenda-number">{$item->getPosition()}.</span>
			<span class="me-auto">{$item->getTitle()}</span>
			<span n:if="$openRound" class="badge status-badge bg-warning-subtle text-warning-emphasis">hlasuje se</span>
			<span n:if="$decided" class="badge status-badge bg-success-subtle text-success-emphasis">rozhodnuto</span>
		</div>
		<div class="card-body">
			<div n:if="$item->getProposedResolution()" class="proposal-text mb-3">
				<div class="small fw-semibold text-body-secondary mb-1">Návrh usnesení</div>
				<div class="text-break">{$item->getProposedResolution()|nl2p}</div>
			</div>

			{foreach $itemRounds as $round}
				{if $round->isOpen()}
					{include openRound, round: $round}
				{else}
					{include closedRound, round: $round}
				{/if}
			{/foreach}

			{if $canVote && !$openRound}
				<div class="d-flex flex-wrap align-items-center gap-2">
					<form n:if="$item->getProposedResolution() && !$decided" method="post" action="{link openVoting!, itemId: $item->getId()}" class="ajax">
						<input type="hidden" name="type" value="proposal">
						<button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-hand-index-thumb" aria-hidden="true"></i> Hlasovat o návrhu usnesení</button>
					</form>
					<button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="collapse" data-bs-target="#jine-hlasovani-{$item->getId()}" aria-expanded="false">{$itemRounds || !$item->getProposedResolution() ? 'Hlasování…' : 'Jiné hlasování…'}</button>
				</div>
				<form method="post" action="{link openVoting!, itemId: $item->getId()}" class="collapse ajax voting-other mt-3" id="jine-hlasovani-{$item->getId()}">
					<div class="row g-2">
						<div class="col-md-5">
							<label class="form-label small" for="voting-type-{$item->getId()}">Typ hlasování</label>
							<select name="type" class="form-select form-select-sm" id="voting-type-{$item->getId()}">
								<option n:if="!$decided" value="proposal">{App\Model\Meeting\VotingType::Proposal->label()}</option>
								<option n:foreach="$otherVotingTypes as $votingType" value="{$votingType->value}">{$votingType->label()}</option>
							</select>
						</div>
						<div class="col-md-7">
							<label class="form-label small" for="voting-candidate-{$item->getId()}">Kandidát <span class="text-body-secondary">(jen u volby osoby)</span></label>
							<select name="candidateId" class="form-select form-select-sm" id="voting-candidate-{$item->getId()}">
								<option value="">—</option>
								<option n:foreach="$candidates as $candidate" value="{$candidate->getId()}">{$candidate->getFullName()}</option>
							</select>
						</div>
						<div class="col-12">
							<label class="form-label small" for="voting-text-{$item->getId()}">Znění návrhu</label>
							<textarea name="proposalText" rows="3" class="form-control form-control-sm" id="voting-text-{$item->getId()}" placeholder="{$meeting->getBody()->getName()} schvaluje / volí …"></textarea>
						</div>
					</div>
					<button type="submit" class="btn btn-primary btn-sm mt-2">Zahájit hlasování</button>
				</form>
			{elseif !$itemRounds}
				<p class="small text-body-secondary mb-0">{$item->getProposedResolution() ? 'Zatím se nehlasovalo.' : 'Bez návrhu usnesení.'}</p>
			{/if}
		</div>
	</section>
{else}
	<div class="card"><div class="card-body empty-state"><i class="bi bi-list-ol" aria-hidden="true"></i>Zasedání nemá program.</div></div>
{/foreach}
{/snippet}

{define roundTitle, App\Model\Meeting\VotingRound $round}
	<div class="fw-semibold">
		Hlasování č. {$round->getSequence()} – {$round->getType()->label()}{if $round->getCandidate()}: {$round->getCandidate()->getFullName()}{/if}
		<span class="small fw-normal text-body-secondary">· {$round->getOpenedAt()->format('G:i')}</span>
	</div>
	<div n:if="$round->getProposalText()" class="small text-break voting-text">{$round->getProposalText()|nl2p}</div>
{/define}

{define openRound, App\Model\Meeting\VotingRound $round}
	{var $roundVoters = $voters($round)}
	{var $rule = App\Model\Meeting\VotingRule::forBody($round->getMeeting()->getBody())}
	<div class="voting-round voting-round-open mb-3">
		<div class="d-flex flex-wrap align-items-start gap-2 mb-2">
			<div class="me-auto min-w-0">{include roundTitle, round: $round}</div>
			<span class="badge status-badge bg-warning-subtle text-warning-emphasis">probíhá</span>
		</div>
		<div class="voting-tally mb-2" aria-live="polite">
			{foreach $voteChoices as $choice}
				<span n:class="voting-tally-item, 'text-' . $choice->tone() . '-emphasis'"><strong>{$round->count($choice)}</strong> {$choice->label()}</span>
			{/foreach}
			<span class="voting-tally-item text-body-secondary"><strong>{count($roundVoters) - $round->count(App\Model\Meeting\VoteChoice::For) - $round->count(App\Model\Meeting\VoteChoice::Against) - $round->count(App\Model\Meeting\VoteChoice::Abstain)}</strong> nehlasoval</span>
			<span class="voting-tally-item text-body-secondary">k přijetí {$rule->required()} pro z {$rule->members}</span>
		</div>
		<ul class="list-unstyled voting-matrix mb-2">
			<li n:foreach="$roundVoters as $voter" class="voting-matrix-row">
				{var $current = $round->getVoteOf($voter)}
				<span class="text-truncate">{$voter->getFullName()}</span>
				{if $canCorrect}
					<form method="post" action="{link vote!, roundId: $round->getId(), personId: $voter->getId()}" class="ajax attendance-choices" role="group" aria-label="Hlas: {$voter->getFullName()}">
						<button n:foreach="$voteChoices as $choice" type="submit" name="choice" value="{$current === $choice ? 'not_voting' : $choice->value}"
							n:class="btn, btn-sm, $current === $choice ? 'btn-' . $choice->tone() : btn-outline-secondary"
							aria-pressed="{$current === $choice ? 'true' : 'false'}">{$choice->label()|firstUpper}</button>
					</form>
				{else}
					<span>{$current?->label() ?? 'nehlasoval'}</span>
				{/if}
			</li>
		</ul>
		<div n:if="$canCorrect" class="d-flex flex-wrap gap-2">
			<form method="post" action="{link allFor!, roundId: $round->getId()}" class="ajax">
				<button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-check2-all" aria-hidden="true"></i> Všichni přítomní pro</button>
			</form>
			<form method="post" action="{link closeVoting!, roundId: $round->getId()}" class="ajax">
				<button type="submit" class="btn btn-sm btn-primary" data-confirm="Ukončit hlasování? Kdo nemá zapsaný hlas, nehlasoval.">Ukončit hlasování</button>
			</form>
			<form method="post" action="{link deleteVoting!, roundId: $round->getId()}" class="ajax ms-auto">
				<button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none" data-confirm="Zrušit hlasování založené omylem?">Zrušit hlasování</button>
			</form>
		</div>
		<p class="small text-body-secondary mt-2 mb-0">Hlasují členové přítomní v {$round->getOpenedAt()->format('G:i')} ({count($roundVoters)}). Kliknutím na zvolenou možnost hlas zrušíte.</p>
	</div>
{/define}

{define closedRound, App\Model\Meeting\VotingRound $round}
	{var $result = $round->getResult()}
	<div class="voting-round mb-3">
		<div class="d-flex flex-wrap align-items-start gap-2">
			<div class="me-auto min-w-0">{include roundTitle, round: $round}</div>
			<span n:if="$result" n:class="badge, status-badge, 'bg-' . $result->tone() . '-subtle', 'text-' . $result->tone() . '-emphasis'">{$result->label($round->getType())}</span>
		</div>
		<div class="small mt-1">
			{foreach App\Model\Meeting\VoteChoice::cases() as $choice}<strong>{$round->count($choice)}</strong> {$choice->label()}{sep} · {/sep}{/foreach}
			<span class="text-body-secondary">(z {$round->getMembersCount()} členů)</span>
		</div>
		<details class="small mt-1 voting-names">
			<summary class="text-body-secondary">Jmenovitě</summary>
			<dl class="row mb-0 mt-1">
				{foreach App\Model\Meeting\VoteChoice::cases() as $choice}
					{var $names = array_map(fn($vote) => $vote->getPerson()->getFullName(), array_filter($round->getVotes(), fn($vote) => $vote->getChoice() === $choice))}
					<dt n:if="$names" class="col-sm-3 fw-normal text-body-secondary">{$choice->label()|firstUpper}</dt>
					<dd n:if="$names" class="col-sm-9 mb-1">{implode(', ', $names)}</dd>
				{/foreach}
			</dl>
		</details>
		<form n:if="$canCorrect" method="post" action="{link reopenVoting!, roundId: $round->getId()}" class="ajax mt-1">
			<button type="submit" class="btn btn-sm btn-link text-decoration-none px-0" data-confirm="Znovu otevřít hlasování a opravit hlasy?">Opravit hlasování</button>
		</form>
	</div>
{/define}
