{block title}{$item->getNumber()}. {$item->getTitle()}{/block}

{block breadcrumbs}
	<li class="breadcrumb-item"><a n:href="Meeting:">Zasedání</a></li>
	<li class="breadcrumb-item"><a n:href="Meeting:detail, id: $meeting->getId()">{$meeting->getTitle()}</a></li>
	<li class="breadcrumb-item active" aria-current="page">Bod {$item->getNumber()}</li>
{/block}

{block content}
{varType App\Model\Meeting\AgendaItem $item}
{varType App\Model\Meeting\Meeting $meeting}
{varType App\Model\Meeting\AgendaItem|null $previous}
{varType App\Model\Meeting\AgendaItem|null $next}
{varType bool $canEdit}
{varType bool $canDelete}
{varType App\Model\Attachment\Attachment[] $attachments}
{varType bool $canUpload}
{varType bool $canDeleteAttachment}
{varType App\Model\Comment\CommentThread[] $threads}
{varType bool $canComment}
{varType bool $canModerate}
{varType int $currentUserId}

<div class="d-flex flex-wrap align-items-start gap-3 mb-4">
	<div class="me-auto">
		<div class="small text-body-secondary mb-1">Bod {$item->getNumber()} z {count($meeting->getAgendaItems())} · {$meeting->getTitle()}, {$meeting->getScheduledAt()|czDate}</div>
		<h1 class="h3 mb-1">{$item->getTitle()}</h1>
		<p class="text-body-secondary mb-0" n:if="$item->getRapporteur()"><i class="bi bi-person" aria-hidden="true"></i> Předkládá {$item->getRapporteur()->getFullName()}</p>
		<a n:if="$item->getProject() && moduleEnabled(App\Model\Municipality\Module::Plans)" n:href="Project:detail, id: $item->getProject()->getId()" class="badge bg-primary-subtle text-primary-emphasis text-decoration-none mt-2"><i class="bi bi-kanban" aria-hidden="true"></i> Plán: {$item->getProject()->getTitle()} · {$item->getProject()->getStatus()->label()}</a>
	</div>
	<div class="d-flex flex-wrap gap-2">
		<a n:if="$canEdit" n:href="edit, id: $item->getId()" class="btn btn-outline-secondary"><i class="bi bi-pencil" aria-hidden="true"></i> Upravit</a>
		<form n:if="$canDelete" method="post" action="{link delete!}" class="d-inline">
			<button type="submit" class="btn btn-outline-danger" data-confirm="Odstranit bod „{$item->getTitle()}“ z programu?" title="Odstranit bod"><i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">Odstranit</span></button>
		</form>
	</div>
</div>

<div class="row g-4">
	<div class="col-xl-8 d-flex flex-column gap-4">
		<div class="card">
			<div class="card-body">
				<h2 class="section-label">Důvodová zpráva</h2>
				{if $item->getDescription()}
					<div class="text-break">{$item->getDescription()|nl2p}</div>
				{else}
					<p class="text-body-secondary mb-0">Bez popisu.</p>
				{/if}

				<h2 class="section-label mt-4">Návrh usnesení</h2>
				{if $item->getProposedResolution()}
					<blockquote class="proposal-quote text-break">{$item->getProposedResolution()|nl2p}</blockquote>
				{else}
					<p class="text-body-secondary mb-0">Bod je bez usnesení (informace, diskuse).</p>
				{/if}
			</div>
		</div>

		{var $uploadForm = $canUpload ? $control['attachmentForm'] : null}
		<div n:class="card, $canUpload ? dropzone" id="prilohy" n:attr="data-dropzone: $canUpload ? 1 : null, data-dropzone-modal: $canUpload ? '#attachment-modal' : null">
			<div class="card-header d-flex align-items-center gap-2">
				<span class="me-auto"><i class="bi bi-paperclip" aria-hidden="true"></i> Přílohy</span>
				<span n:if="$attachments" class="badge text-bg-light">{count($attachments)}</span>
				<button n:if="$canUpload" type="button" class="btn btn-sm btn-outline-primary py-0 px-2" data-bs-toggle="modal" data-bs-target="#attachment-modal" title="Přidat přílohu"><i class="bi bi-plus-lg" aria-hidden="true"></i><span class="visually-hidden">Přidat přílohu</span></button>
			</div>
			<ul n:if="$attachments" class="list-group list-group-flush">
				<li n:foreach="$attachments as $attachment" class="list-group-item d-flex align-items-center gap-3 py-3">
					<i class="bi {$attachment->getFile()|fileIcon} fs-3 text-primary" aria-hidden="true"></i>
					<div class="me-auto min-w-0">
						<a n:href="Attachment:preview, id: $attachment->getId()" target="_blank" rel="noopener" class="fw-semibold text-break">{$attachment->getTitle()}</a>
						<div class="small text-body-secondary">
							{$attachment->getFile()->size|bytes} · {$attachment->getCreatedAt()|czDateTime}{if $attachment->getUploadedBy()} · {$attachment->getUploadedBy()->getName()}{/if}
							<span n:if="!$attachment->isPublicForMembers()" class="badge bg-warning-subtle text-warning-emphasis ms-1">jen pro úřad</span>
						</div>
					</div>
					<a n:href="Attachment:download, id: $attachment->getId()" class="btn btn-sm btn-light" title="Stáhnout"><i class="bi bi-download" aria-hidden="true"></i><span class="visually-hidden">Stáhnout</span></a>
					<form n:if="$canDeleteAttachment" method="post" action="{link deleteAttachment!, attachmentId: $attachment->getId()}">
						<button type="submit" class="btn btn-sm btn-light text-danger" title="Smazat" data-confirm="Smazat přílohu „{$attachment->getTitle()}“?"><i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">Smazat</span></button>
					</form>
				</li>
			</ul>
			<div n:if="!$attachments" class="card-body empty-state py-4">
				<i class="bi bi-paperclip" aria-hidden="true"></i>
				K bodu zatím nejsou přiložené podklady.{if $canUpload} Přetáhněte je sem, nebo klikněte na +.{/if}
			</div>
			<div n:if="$canUpload" class="dropzone-overlay" aria-hidden="true"><i class="bi bi-cloud-arrow-up"></i> Pusťte soubory sem</div>

			<div n:if="$canUpload" class="modal fade" id="attachment-modal" tabindex="-1" aria-labelledby="attachment-modal-title" aria-hidden="true" n:attr="data-show-on-load: $uploadForm?->hasErrors() ? 1 : null">
				<div class="modal-dialog modal-dialog-centered">
					{form attachmentForm, class: 'modal-content'}
						<div class="modal-header">
							<h2 class="modal-title h5" id="attachment-modal-title">Přidat přílohy</h2>
							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít"></button>
						</div>
						<div class="modal-body">
							<div n:foreach="$form->getOwnErrors() as $error" class="alert alert-danger py-2">{$error}</div>
							<label n:name="files" class="form-label">Soubory</label>
							<input n:name="files" n:class="form-control, $form['files']->hasErrors() ? is-invalid" data-dropzone-input>
							<ul class="dropzone-list list-unstyled small mb-0 mt-2" data-dropzone-list hidden></ul>
							<div n:ifcontent class="invalid-feedback d-block">{inputError files}</div>
							<div class="form-text">{$form['files']->getOption('description')}</div>
							<div class="form-check mt-3 mb-0">
								<input n:name="publicForMembers" class="form-check-input">
								<label n:name="publicForMembers" class="form-check-label">{$form['publicForMembers']->getCaption()}</label>
							</div>
						</div>
						<div class="modal-footer">
							<button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Zrušit</button>
							<button n:name="upload" class="btn btn-primary"><i class="bi bi-upload" aria-hidden="true"></i> Nahrát</button>
						</div>
					{/form}
				</div>
			</div>
		</div>

		{snippet comments}
			{include '../../UI/Comment/@discussion.latte',
				threads: $threads,
				canComment: $canComment,
				formName: 'commentForm',
				canDelete: fn(App\Model\Comment\Comment $c): bool => $canModerate || $c->getAuthorUserId() === $currentUserId,
				deleteLink: fn(App\Model\Comment\Comment $c): string => $presenter->link('deleteComment!', ['commentId' => $c->getId()]),
				attachmentLink: fn(App\Model\Attachment\Attachment $a): string => $presenter->link('Attachment:preview', ['id' => $a->getId()]),
			}
		{/snippet}
	</div>

	<div class="col-xl-4 d-flex flex-column gap-4">
		<div class="card">
			<div class="card-header">Program</div>
			<div class="list-group list-group-flush small">
				<a n:foreach="$meeting->getAgendaItems() as $programItem" n:href="detail, id: $programItem->getId()" n:class="list-group-item, list-group-item-action, $programItem === $item ? active">
					{$programItem->getNumber()}. {$programItem->getTitle()}
				</a>
			</div>
		</div>
		<div class="d-flex justify-content-between">
			<a n:if="$previous" n:href="detail, id: $previous->getId()" class="btn btn-sm btn-outline-secondary"><i class="bi bi-chevron-left" aria-hidden="true"></i> Bod {$previous->getNumber()}</a>
			<span n:if="!$previous"></span>
			<a n:if="$next" n:href="detail, id: $next->getId()" class="btn btn-sm btn-outline-secondary">Bod {$next->getNumber()} <i class="bi bi-chevron-right" aria-hidden="true"></i></a>
		</div>
	</div>
</div>
