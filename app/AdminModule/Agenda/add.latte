{block title}Nový bod – {$meeting->getTitle()}{/block}

{block breadcrumbs}
	<li class="breadcrumb-item"><a n:href="Meeting:">Zasedání</a></li>
	<li class="breadcrumb-item"><a n:href="Meeting:detail, id: $meeting->getId()">{$meeting->getTitle()}</a></li>
	<li class="breadcrumb-item active" aria-current="page">Nový bod</li>
{/block}

{block content}
{varType App\Model\Meeting\Meeting $meeting}
<h1 class="h3 mb-1">Nový bod programu</h1>
<p class="text-body-secondary mb-4">{$meeting->getTitle()} · {$meeting->getBody()->getName()} · {$meeting->getScheduledAt()|czDateTime}</p>
{include '@form.latte', meeting: $meeting}
