{block title}{$person->getFullName()}{/block}

{block breadcrumbs}
	<li class="breadcrumb-item"><a n:href="Member:">Osoby a orgány</a></li>
	<li class="breadcrumb-item"><a n:href="default">Osoby</a></li>
	<li class="breadcrumb-item active" aria-current="page">{$person->getFullName()}</li>
{/block}

{block content}
{varType App\Model\People\Person $person}
<h1 class="h3 mb-4">{$person->getFullName()}</h1>
<div class="card" style="max-width: 40rem"><div class="card-body">{control personForm}</div></div>
