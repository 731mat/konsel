{parameters array $variables, array $categories}
<div class="row g-4">
	<div class="col-xl-8">
		<div class="card"><div class="card-body">{control resolutionTemplateForm}</div></div>
		<datalist id="template-categories">
			<option n:foreach="$categories as $category" value="{$category}"></option>
		</datalist>
	</div>
	<div class="col-xl-4">
		<div class="card">
			<div class="card-header">Proměnné</div>
			<ul class="list-group list-group-flush small">
				<li n:foreach="$variables as $variable => $description" class="list-group-item"><code>{$variable}</code> – {$description}</li>
			</ul>
		</div>
	</div>
</div>
