{block title}{$resolutionTemplate->getTitle()}{/block}

{block breadcrumbs}
	<li class="breadcrumb-item"><a n:href="default">Šablony</a></li>
	<li class="breadcrumb-item active" aria-current="page">{$resolutionTemplate->getTitle()}</li>
{/block}

{block content}
{varType App\Model\Template\ResolutionTemplate $resolutionTemplate}
{varType array<string, string> $variables}
{varType string[] $categories}
<h1 class="h3 mb-4">{$resolutionTemplate->getTitle()}</h1>
{include '@form.latte', variables: $variables, categories: $categories}
