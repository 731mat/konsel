{block title}Můj účet{/block}

{block breadcrumbs}
	<li class="breadcrumb-item active" aria-current="page">Můj účet</li>
{/block}

{block content}
<h1 class="h3 mb-4">Můj účet</h1>

<div n:if="$mustChangePassword" class="alert alert-warning" style="max-width: 30rem">
	Přihlásili jste se dočasným heslem. Před pokračováním si prosím nastavte vlastní heslo.
</div>

<div class="card" style="max-width: 30rem">
	<div class="card-header fw-semibold">Změna hesla</div>
	<div class="card-body">{control passwordForm}</div>
</div>

<div n:if="$currentMunicipality?->isModuleEnabled(App\Model\Municipality\Module::AiConnections)" class="card mt-4" style="max-width: 30rem">
	<div class="card-body d-flex align-items-center gap-3">
		<i class="bi bi-robot fs-3 text-primary" aria-hidden="true"></i>
		<div class="me-auto">
			<div class="fw-semibold">Připojení AI</div>
			<div class="small text-body-secondary">Claude, ChatGPT a další asistenti s přístupem k vašemu účtu.</div>
		</div>
		<a n:href=":Admin:AiConnection:" class="btn btn-outline-primary btn-sm">Spravovat</a>
	</div>
</div>
