{block title}{$meeting->getTitle()} – {$meeting->getBody()->getName()}{/block}

{block breadcrumbs}
	<li class="breadcrumb-item"><a n:href="default">Zasedání</a></li>
	<li class="breadcrumb-item active" aria-current="page">{$meeting->getTitle()}</li>
{/block}

{block content}
{varType App\Model\Meeting\Meeting $meeting}
{varType string $tab}
{varType App\Model\Meeting\AttendanceOverview|null $attendance}
{varType App\Model\Resolution\Resolution[] $resolutions}
{varType array<string, string> $tabs}
{varType App\Model\Meeting\MeetingTransition[] $transitions}
{varType string[] $warnings}
{varType array<string, string> $confirmations}
{varType bool $canEdit}
{varType bool $canDelete}
{varType bool $canEditProgram}
{varType array<int, int> $attachmentCounts}
{varType array<int, int> $commentCounts}
{varType App\Model\Document\MeetingDocumentType[] $documentTypes}
{varType bool $canViewDocuments}
{varType App\Model\Document\ArchivedDocument[] $archivedDocuments}
{varType bool $canArchive}
{varType bool $canDeleteArchived}
{varType bool $missingFinal}
{varType App\Model\Template\MeetingTemplate[] $meetingTemplates}

<div class="d-flex flex-wrap align-items-start gap-3 mb-4">
	<div class="me-auto">
		<h1 class="h3 mb-1">
			{$meeting->getTitle()}
			<span class="fs-6 align-middle">{include '@status.latte', status: $meeting->getStatus()}</span>
		</h1>
		<p class="text-body-secondary mb-0">
			<a n:href="default, body: $meeting->getBody()->getId()" class="link-secondary">{$meeting->getBody()->getName()}</a>
			· <i class="bi bi-calendar-event" aria-hidden="true"></i> {$meeting->getScheduledAt()|czDateTime}
			· <i class="bi bi-geo-alt" aria-hidden="true"></i> {$meeting->getPlace()}
		</p>
	</div>

	<div class="d-flex flex-wrap gap-2">
		<a n:if="in_array($meeting->getStatus(), [App\Model\Meeting\MeetingStatus::InProgress, App\Model\Meeting\MeetingStatus::Closed], true)" n:href="Proceedings:default, id: $meeting->getId()" class="btn btn-outline-primary"><i class="bi bi-easel" aria-hidden="true"></i> Průběh zasedání</a>
		<a n:if="$canEdit && $meeting->canReschedule()" n:href="edit, id: $meeting->getId()" class="btn btn-outline-secondary"><i class="bi bi-pencil" aria-hidden="true"></i> Upravit</a>

		{foreach $transitions as $transition}
			{var $confirm = $confirmations[$transition->value] ?? null}
			{if $transition->isReopening()}
				<a n:href="reopen, id: $meeting->getId()" class="btn btn-outline-danger">{$transition->label()}</a>
			{else}
				<form method="post" action="{link transition!, transition: $transition->value}" class="d-inline">
					<button type="submit" class="btn btn-primary" data-confirm={$confirm}>{$transition->label()}</button>
				</form>
			{/if}
		{/foreach}

		<form n:if="$canDelete" method="post" action="{link delete!}" class="d-inline">
			<button type="submit" class="btn btn-outline-danger" data-confirm="Opravdu smazat zasedání {$meeting->getTitle()}?" title="Smazat zasedání"><i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">Smazat</span></button>
		</form>
	</div>
</div>

<div n:if="$warnings" class="alert alert-warning">
	<i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
	{foreach $warnings as $warning}{$warning}{sep} {/sep}{/foreach}
</div>

<div class="row g-4">
	<div class="col-xl-8">
		<ul class="nav nav-tabs">
			<li n:foreach="$tabs as $key => $label" class="nav-item">
				<a n:href="detail, id: $meeting->getId(), tab: $key" n:class="nav-link, $key === $tab ? active" aria-current={$key === $tab ? 'page' : null}>{$label}{if $key === 'program' && $meeting->getAgendaItems()} <span class="badge text-bg-light">{count($meeting->getAgendaItems())}</span>{/if}</a>
			</li>
		</ul>
		<div class="card border-top-0 rounded-top-0">
			{if $tab === 'program'}
				{snippet program}
					{var $items = $meeting->getAgendaItems()}
					{var $topCount = count(array_filter($items, fn($i) => !$i->isSubItem()))}
					<ol n:if="$items" class="list-group list-group-flush agenda-list" data-sortable-url={$canEditProgram ? $presenter->link('reorder!') : null}>
						<li n:foreach="$items as $item" n:class="list-group-item, d-flex, align-items-start, gap-3, py-3, $item->isSubItem() ? agenda-subitem" data-id="{$item->getId()}">
							{var $siblingPosition = $item->isSubItem() ? $item->getSubNumber() : $item->getTopNumber()}
							{var $siblingCount = $item->isSubItem() ? count($meeting->getSubItems($item->getParent())) : $topCount}
							<span n:if="$canEditProgram" class="drag-handle" title="Přetáhněte pro změnu pořadí"><i class="bi bi-grip-vertical" aria-hidden="true"></i></span>
							<span class="agenda-number">{$item->getNumber()}.</span>
							<div class="me-auto min-w-0">
								<a n:href="Agenda:detail, id: $item->getId()" class="fw-semibold">{$item->getTitle()}</a>
								<span n:if="$item->isAddedDuringMeeting()" class="badge bg-info-subtle text-info-emphasis ms-1">doplněno na zasedání</span>
								<div class="small text-body-secondary d-flex flex-wrap gap-3 mt-1">
									<span n:if="$item->getRapporteur()"><i class="bi bi-person" aria-hidden="true"></i> {$item->getRapporteur()->getFullName()}</span>
									<span n:if="$item->getProposedResolution() && !$item->hasSubItems()"><i class="bi bi-journal-check" aria-hidden="true"></i> návrh usnesení</span>
									{var $subCount = count($meeting->getSubItems($item))}
									<span n:if="$subCount"><i class="bi bi-diagram-2" aria-hidden="true"></i> {$subCount} {$subCount < 5 ? 'podbody' : 'podbodů'} – hlasuje se o každém zvlášť</span>
									<span n:if="$item->getProject()"><i class="bi bi-kanban" aria-hidden="true"></i> {$item->getProject()->getTitle()|truncate: 40}</span>
									<span n:if="$commentCounts[$item->getId()] ?? 0"><i class="bi bi-chat-left-text" aria-hidden="true"></i> {$commentCounts[$item->getId()]}</span>
									<span n:if="$attachmentCounts[$item->getId()] ?? 0"><i class="bi bi-paperclip" aria-hidden="true"></i> {$attachmentCounts[$item->getId()]} {$attachmentCounts[$item->getId()] === 1 ? 'příloha' : ($attachmentCounts[$item->getId()] < 5 ? 'přílohy' : 'příloh')}</span>
								</div>
							</div>
							<div n:if="$canEditProgram" class="d-flex gap-1 flex-shrink-0">
								<a n:if="!$item->isSubItem()" n:href="Agenda:add, meeting: $meeting->getId(), parent: $item->getId()" class="btn btn-sm btn-light" title="Přidat podbod"><i class="bi bi-plus-lg" aria-hidden="true"></i><span class="visually-hidden">Přidat podbod</span></a>
								<form n:if="$siblingPosition > 1" method="post" action="{link moveItem!, itemId: $item->getId(), position: $siblingPosition - 1}" class="ajax">
									<button type="submit" class="btn btn-sm btn-light" title="Posunout nahoru"><i class="bi bi-arrow-up" aria-hidden="true"></i><span class="visually-hidden">Nahoru</span></button>
								</form>
								<form n:if="$siblingPosition < $siblingCount" method="post" action="{link moveItem!, itemId: $item->getId(), position: $siblingPosition + 1}" class="ajax">
									<button type="submit" class="btn btn-sm btn-light" title="Posunout dolů"><i class="bi bi-arrow-down" aria-hidden="true"></i><span class="visually-hidden">Dolů</span></button>
								</form>
							</div>
						</li>
					</ol>
					<div n:if="!$items" class="card-body empty-state">
						<i class="bi bi-list-ol" aria-hidden="true"></i>
						Program zasedání zatím není sestavený.
					</div>
					<div n:if="$canEditProgram" class="card-footer bg-transparent d-flex flex-wrap gap-2">
						<a n:href="Agenda:add, meeting: $meeting->getId()" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg" aria-hidden="true"></i> Přidat bod</a>
						<form method="post" action="{link insertStandard!}" class="ajax">
							<button type="submit" class="btn btn-outline-secondary btn-sm"><i class="bi bi-magic" aria-hidden="true"></i> Vložit standardní body</button>
						</form>
						<form n:if="$meetingTemplates" method="post" action="{link applyTemplate!}" class="ajax d-flex gap-1">
							<select name="templateId" class="form-select form-select-sm" aria-label="Šablona programu" required>
								<option value="">Program ze šablony…</option>
								<option n:foreach="$meetingTemplates as $meetingTemplate" value="{$meetingTemplate->getId()}">{$meetingTemplate->getName()}</option>
							</select>
							<button type="submit" class="btn btn-outline-secondary btn-sm text-nowrap">Vložit</button>
						</form>
					</div>
				{/snippet}
			{elseif $tab === 'proceedings' && $attendance}
				{var $quorum = $attendance->quorum}
				<div class="card-body">
					<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
						<div n:class="quorum-indicator, $quorum->isReached() ? quorum-ok : quorum-missing">
							<i n:class="bi, $quorum->isReached() ? bi-check-circle-fill : bi-exclamation-octagon-fill" aria-hidden="true"></i>
							<div>
								<div class="fw-semibold">{$quorum->isReached() ? 'Usnášeníschopné' : 'Není usnášeníschopné'}</div>
								<div class="small">přítomno {$quorum->present} z {$quorum->members}</div>
							</div>
						</div>
						<div class="small text-body-secondary me-auto">
							{$attendance->count(App\Model\Meeting\AttendanceStatus::Excused)} omluveno · {$attendance->count(App\Model\Meeting\AttendanceStatus::Absent)} neomluveno{if !$attendance->isComplete()} · {$attendance->count(App\Model\Meeting\AttendanceStatus::Unknown)} nezapsáno{/if}
						</div>
						<a n:href="Proceedings:default, id: $meeting->getId()" class="btn btn-primary"><i class="bi bi-easel" aria-hidden="true"></i> Otevřít průběh</a>
					</div>
					<p class="small text-body-secondary mb-0">Na obrazovce průběhu zapíšete docházku (i pozdní příchody a odchody), hlasování a diskusi k bodům.</p>
				</div>
			{elseif $tab === 'resolutions' && $resolutions}
				<ul class="list-group list-group-flush">
					<li n:foreach="$resolutions as $resolution" class="list-group-item resolution-row">
						<div class="resolution-number">{$resolution->getNumber()}</div>
						<div class="min-w-0">
							<div class="small text-body-secondary">Bod {$resolution->getAgendaItem()->getNumber()}. {$resolution->getAgendaItem()->getTitle()}</div>
							<div class="text-break">{$resolution->getText()|nl2p}</div>
						</div>
						<span n:class="badge, status-badge, 'bg-' . $resolution->getStatus()->tone() . '-subtle', 'text-' . $resolution->getStatus()->tone() . '-emphasis', align-self-start">{$resolution->getStatus()->label()}</span>
					</li>
				</ul>
			{elseif $tab === 'documents' && $canViewDocuments}
				<div n:if="$missingFinal && $canArchive" class="alert alert-warning d-flex flex-wrap align-items-center gap-2 m-3 mb-0">
					<i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
					<span class="me-auto">Zápis je ověřený, ale v archivu chybí jeho konečná verze.</span>
					<form method="post" action="{link archiveFinal!}"><button type="submit" class="btn btn-sm btn-warning">Uložit konečné verze</button></form>
				</div>
				<div class="list-group list-group-flush">
					<div n:foreach="$documentTypes as $documentType" class="list-group-item py-3">
						<div class="d-flex flex-wrap flex-md-nowrap align-items-center gap-3">
							<i class="bi bi-file-earmark-pdf fs-3 text-danger d-none d-md-inline" aria-hidden="true"></i>
							<div class="flex-grow-1 min-w-0">
								<div class="fw-semibold">{$documentType->label()}</div>
								<div class="small text-body-secondary">{$documentType->description()}</div>
							</div>
							<div class="d-flex gap-2 flex-shrink-0">
								<a n:href="document, id: $meeting->getId(), type: $documentType->value" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye" aria-hidden="true"></i> Zobrazit</a>
								<a n:href="document, id: $meeting->getId(), type: $documentType->value, download: true" class="btn btn-sm btn-primary text-nowrap"><i class="bi bi-download" aria-hidden="true"></i> Stáhnout PDF</a>
							</div>
						</div>
						<div n:ifcontent class="d-flex flex-wrap align-items-center column-gap-3 row-gap-1 small mt-2 ps-md-5">
							<a n:if="$documentType === App\Model\Document\MeetingDocumentType::Minutes" n:href="document, id: $meeting->getId(), type: $documentType->value, named: true" target="_blank" rel="noopener"><i class="bi bi-person-lines-fill" aria-hidden="true"></i> S jmenovitým hlasováním</a>
							<a n:if="$documentType->isEditable()" n:href="document, id: $meeting->getId(), type: $documentType->value, format: doc"><i class="bi bi-file-earmark-word" aria-hidden="true"></i> Stáhnout pro úpravy ve Wordu</a>
							<form n:if="$canArchive" method="post" action="{link archiveDocument!, type: $documentType->value}" class="d-inline">
								<button type="submit" class="btn btn-link btn-sm p-0 align-baseline small" title="Uloží PDF v současné podobě – např. pozvánku v den vyvěšení"><i class="bi bi-archive" aria-hidden="true"></i> Uložit verzi do archivu</button>
							</form>
						</div>
					</div>
				</div>
				<div class="card-footer bg-transparent small text-body-secondary">
					Dokumenty se vytvářejí vždy z aktuálního stavu zasedání. Zápis je k dispozici po zahájení (do ukončení jako koncept).
					Po ověření zápisu se konečný zápis a usnesení uloží do archivu samy.
				</div>

				<div class="border-top">
					<div class="card-body pb-2">
						<h2 class="h6 mb-1"><i class="bi bi-archive" aria-hidden="true"></i> Archiv dokumentů</h2>
						<p class="small text-body-secondary mb-0">Uložené verze se už nemění. Po ověření zápisu je archiv jen pro přidávání – verze nejde smazat.</p>
					</div>
					<div n:if="$archivedDocuments" class="table-responsive">
						<table class="table table-sm align-middle mb-0">
							<thead class="small text-body-secondary">
								<tr><th class="ps-3">Dokument</th><th>Verze</th><th>Uloženo</th><th class="d-none d-md-table-cell">Kdo</th><th class="pe-3 text-end"><span class="visually-hidden">Akce</span></th></tr>
							</thead>
							<tbody>
								<tr n:foreach="$archivedDocuments as $archived">
									<td class="ps-3">
										<a n:href="archived, id: $meeting->getId(), documentId: $archived->getId()" target="_blank" rel="noopener">{$archived->getType()->label()}</a>
										<span n:if="$archived->isDraft()" class="badge text-bg-warning ms-1">koncept</span>
										<div n:if="$archived->getNote()" class="small text-body-secondary">{$archived->getNote()}</div>
									</td>
									<td class="small"><i class="bi bi-{$archived->getOrigin()->icon()}" aria-hidden="true"></i> {$archived->getOrigin()->label()}</td>
									<td class="small text-nowrap">{$archived->getCreatedAt()|czDateTime}</td>
									<td class="small d-none d-md-table-cell">{$archived->getCreatedBy()?->getName() ?? '—'}</td>
									<td class="pe-3 text-end text-nowrap">
										<a n:href="archived, id: $meeting->getId(), documentId: $archived->getId(), download: true" class="btn btn-sm btn-outline-secondary" title="Stáhnout"><i class="bi bi-download" aria-hidden="true"></i><span class="visually-hidden">Stáhnout</span></a>
										<form n:if="$canDeleteArchived" method="post" action="{link deleteArchived!, documentId: $archived->getId()}" class="d-inline">
											<button type="submit" class="btn btn-sm btn-outline-danger" data-confirm="Smazat tuto verzi z archivu?" title="Smazat"><i class="bi bi-trash" aria-hidden="true"></i><span class="visually-hidden">Smazat</span></button>
										</form>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
					<div n:if="!$archivedDocuments" class="card-body pt-0 small text-body-secondary">Archiv je zatím prázdný.</div>
					<div n:if="$canArchive" class="card-footer bg-transparent">
						{form archiveUploadForm, class: 'row g-2 align-items-end'}
							<div n:foreach="$form->getOwnErrors() as $error" class="col-12"><div class="alert alert-danger py-2 mb-0">{$error}</div></div>
							<div class="col-12 small fw-semibold">Nahrát podepsaný originál (sken PDF)</div>
							<div class="col-md-3">
								<label n:name="type" class="form-label small mb-1">Dokument</label>
								<select n:name="type" class="form-select form-select-sm"></select>
							</div>
							<div class="col-md-4">
								<label n:name="file" class="form-label small mb-1">Soubor PDF</label>
								<input n:name="file" n:class="form-control, form-control-sm, $form['file']->hasErrors() ? is-invalid">
								<div n:ifcontent class="invalid-feedback d-block">{inputError file}</div>
							</div>
							<div class="col-md">
								<label n:name="note" class="form-label small mb-1">Poznámka</label>
								<input n:name="note" class="form-control form-control-sm">
							</div>
							<div class="col-auto">
								<button n:name="upload" class="btn btn-sm btn-outline-primary"><i class="bi bi-upload" aria-hidden="true"></i> Nahrát</button>
							</div>
						{/form}
					</div>
				</div>
			{else}
				<div class="card-body empty-state">
					{switch $tab}
						{case 'proceedings'}
							<i class="bi bi-people" aria-hidden="true"></i>
							Docházka, hlasování a diskuse k bodům se zaznamenávají po zahájení zasedání.
						{case 'resolutions'}
							<i class="bi bi-journal-check" aria-hidden="true"></i>
							Usnesení vzniknou přijetím hlasování o bodech programu (obrazovka Průběh) a dostanou číslo podle masky orgánu.
						{case 'documents'}
							<i class="bi bi-file-earmark-text" aria-hidden="true"></i>
							Dokumenty jsou dostupné jen s oprávněním k dokumentům.
					{/switch}
				</div>
			{/if}
		</div>
	</div>

	<div class="col-xl-4 d-flex flex-column gap-4">
		<div class="card">
			<div class="card-header fw-semibold">Údaje o zasedání</div>
			<div class="card-body">
				<dl class="row mb-0 small">
					<dt class="col-5 fw-normal text-body-secondary">Typ</dt><dd class="col-7">{$meeting->getType()->label()}</dd>
					<dt class="col-5 fw-normal text-body-secondary">Pořadové číslo</dt><dd class="col-7">{$meeting->getNumber()}</dd>
					<dt class="col-5 fw-normal text-body-secondary">Volební období</dt><dd class="col-7">{$meeting->getBody()->getTerm()->getName()}</dd>
					<dt class="col-5 fw-normal text-body-secondary">Sdíleno</dt><dd class="col-7">{($meeting->getSharedAt()|czDateTime) ?: '—'}</dd>
					<dt class="col-5 fw-normal text-body-secondary">Zahájeno</dt><dd class="col-7">{($meeting->getStartedAt()|czDateTime) ?: '—'}</dd>
					<dt class="col-5 fw-normal text-body-secondary">Ukončeno</dt><dd class="col-7 mb-0">{($meeting->getEndedAt()|czDateTime) ?: '—'}</dd>
				</dl>
			</div>
		</div>

		<div n:if="$canEdit" class="card">
			<div class="card-body d-flex align-items-center gap-3">
				<i class="bi bi-envelope-paper fs-3 text-primary" aria-hidden="true"></i>
				<div class="me-auto small">
					<div class="fw-semibold">Pozvánky a odkazy</div>
					<div class="text-body-secondary">Pozvánka e-mailem s osobním odkazem – program, podklady a diskuse bez přihlašování.</div>
				</div>
				<a n:href="links, id: $meeting->getId()" class="btn btn-sm btn-outline-primary">{$meeting->getStatus()->isPlanning() ? 'Rozeslat' : 'Spravovat'}</a>
			</div>
		</div>

		<div n:if="$meeting->getReopenings()" class="card">
			<div class="card-header fw-semibold"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Historie znovuotevření</div>
			<ul class="list-group list-group-flush small">
				<li n:foreach="$meeting->getReopenings() as $reopening" class="list-group-item">
					<div class="d-flex flex-wrap gap-2 text-body-secondary">
						<span>{$reopening->getReopenedAt()|czDateTime}</span>
						<span>·</span>
						<span>{$reopening->getReopenedByName()}</span>
						<span>·</span>
						<span>{$reopening->getFromStatus()->label()} → {$reopening->getToStatus()->label()}</span>
					</div>
					<div class="text-break mt-1">{$reopening->getReason()}</div>
				</li>
			</ul>
		</div>

		<div class="card">
			<div class="card-header d-flex align-items-center">
				<span class="fw-semibold me-auto">Funkce</span>
				<a n:if="$canEdit && $meeting->canAssignOfficials()" n:href="officials, id: $meeting->getId()" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil" aria-hidden="true"></i> Určit</a>
			</div>
			<div class="card-body">
				<dl class="row mb-0 small">
					<dt class="col-5 fw-normal text-body-secondary">Předsedající</dt><dd class="col-7">{$meeting->getChairperson()?->getFullName() ?? '—'}</dd>
					<dt class="col-5 fw-normal text-body-secondary">Ověřovatelé</dt>
					<dd class="col-7">
						{foreach $meeting->getVerifiers() as $verifier}{$verifier->getFullName()}{sep}<br>{/sep}{else}—{/foreach}
					</dd>
					<dt class="col-5 fw-normal text-body-secondary">Zapisovatel</dt><dd class="col-7 mb-0">{$meeting->getRecorder()?->getFullName() ?? '—'}</dd>
				</dl>
			</div>
		</div>
	</div>
</div>
