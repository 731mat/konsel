{parameters App\Model\Meeting\MeetingStatus $status}
{var $tone = [
	'draft' => 'secondary',
	'shared' => 'info',
	'in_progress' => 'warning',
	'closed' => 'primary',
	'minutes_approved' => 'success',
][$status->value]}
<span class="badge status-badge bg-{$tone}-subtle text-{$tone}-emphasis border-{$tone}-subtle">{$status->label()}</span>
