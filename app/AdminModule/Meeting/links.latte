{block title}Odkazy pro zastupitele – {$meeting->getTitle()}{/block}

{block breadcrumbs}
	<li class="breadcrumb-item"><a n:href="default">Zasedání</a></li>
	<li class="breadcrumb-item"><a n:href="detail, id: $meeting->getId()">{$meeting->getTitle()}</a></li>
	<li class="breadcrumb-item active" aria-current="page">Odkazy pro zastupitele</li>
{/block}

{block content}
{varType App\Model\Meeting\Meeting $meeting}
{varType App\Model\Access\MeetingAccessToken[] $tokens}
{varType App\Model\People\Membership[] $members}
{varType App\Model\Access\IssuedToken[] $issuedTokens}
{varType Closure $portalLink}
{varType DateTimeImmutable $now}

<div class="d-flex flex-wrap align-items-start gap-3 mb-4">
	<div class="me-auto">
		<h1 class="h3 mb-1">Odkazy pro zastupitele</h1>
		<p class="text-body-secondary mb-0">{$meeting->getTitle()} · {$meeting->getBody()->getName()} · {$meeting->getScheduledAt()|czDateTime}</p>
	</div>
	<form method="post" action="{link issueLinks!}">
		<button type="submit" class="btn btn-primary" data-confirm={$tokens ? 'Vytvořit nové odkazy všem členům? Dosavadní odkazy přestanou platit.' : null}>
			<i class="bi bi-link-45deg" aria-hidden="true"></i> Vytvořit odkazy pro všechny členy
		</button>
	</form>
</div>

<div n:if="$issuedTokens" class="card border-success mb-4">
	<div class="card-header bg-success-subtle text-success-emphasis"><i class="bi bi-check-circle" aria-hidden="true"></i> Nové odkazy – zkopírujte je nebo odešlete hned, později už zobrazit nepůjdou</div>
	<div class="table-responsive">
		<table class="table align-middle mb-0">
			<thead><tr><th>Zastupitel</th><th>Odkaz</th><th></th></tr></thead>
			<tbody>
				<tr n:foreach="$issuedTokens as $issued">
					{var $url = $portalLink($issued)}
					{var $person = $issued->accessToken->getPerson()}
					<td class="text-nowrap">{$person->getFullName()}</td>
					<td style="min-width: 18rem"><input type="text" class="form-control form-control-sm font-monospace" value="{$url}" readonly id="link-{$issued->accessToken->getId()}"></td>
					<td class="text-nowrap text-end">
						<button type="button" class="btn btn-sm btn-outline-secondary" data-copy="#link-{$issued->accessToken->getId()}"><i class="bi bi-clipboard" aria-hidden="true"></i> Kopírovat</button>
						{if $person->getEmail()}
							{var $body = "Dobrý den,\n\nposíláme podklady k {$meeting->getTitle()} ({$meeting->getBody()->getName()}), které se koná {$meeting->getScheduledAt()->format('j. n. Y')} v {$meeting->getScheduledAt()->format('H:i')}.\n\nVáš osobní odkaz: {$url}\n\nOdkaz nepřeposílejte, je určen jen Vám."}
							<a class="btn btn-sm btn-outline-primary" href="mailto:{$person->getEmail()->value}?subject={rawurlencode('Podklady k zasedání ' . $meeting->getScheduledAt()->format('j. n. Y'))|noescape}&body={rawurlencode($body)|noescape}"><i class="bi bi-envelope" aria-hidden="true"></i> E-mail</a>
						{/if}
					</td>
				</tr>
			</tbody>
		</table>
	</div>
</div>

<div class="row g-4">
	<div class="col-xl-8">
		<div class="card">
			<div class="card-header">Vydané odkazy</div>
			{if $tokens}
				<div class="table-responsive">
					<table class="table align-middle mb-0">
						<thead><tr><th>Zastupitel</th><th>Vytvořen</th><th>Platí do</th><th>Použit</th><th>Stav</th><th></th></tr></thead>
						<tbody>
							<tr n:foreach="$tokens as $token">
								<td>{$token->getPerson()->getFullName()}</td>
								<td class="small text-nowrap">{$token->getCreatedAt()|czDateTime}</td>
								<td class="small text-nowrap">{$token->getExpiresAt()|czDate}</td>
								<td class="small text-nowrap">{if $token->getLastUsedAt()}{$token->getLastUsedAt()|czDateTime} ({$token->getUseCount()}×){else}<span class="text-body-secondary">ne</span>{/if}</td>
								<td>
									{if $token->getRevokedAt()}<span class="badge bg-secondary-subtle text-secondary-emphasis">odvolán</span>
									{elseif !$token->isValidAt($now)}<span class="badge bg-warning-subtle text-warning-emphasis">vypršel</span>
									{else}<span class="badge bg-success-subtle text-success-emphasis">platný</span>{/if}
								</td>
								<td class="text-end">
									<form n:if="$token->isValidAt($now)" method="post" action="{link revokeLink!, tokenId: $token->getId()}">
										<button type="submit" class="btn btn-sm btn-light text-danger" data-confirm="Odvolat odkaz pro {$token->getPerson()->getFullName()}?">Odvolat</button>
									</form>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			{else}
				<div class="card-body empty-state"><i class="bi bi-link-45deg" aria-hidden="true"></i>Zatím nebyly vytvořeny žádné odkazy.</div>
			{/if}
		</div>
	</div>
	<div class="col-xl-4">
		<div class="card">
			<div class="card-header">Členové orgánu</div>
			<ul class="list-group list-group-flush">
				<li n:foreach="$members as $membership" class="list-group-item d-flex align-items-center gap-2">
					<span class="me-auto">{$membership->getPerson()->getFullName()}<span class="d-block small text-body-secondary">{$membership->getPerson()->getEmail()?->value ?? 'bez e-mailu'}</span></span>
					<form method="post" action="{link issueLinks!, personId: $membership->getPerson()->getId()}">
						<button type="submit" class="btn btn-sm btn-outline-secondary" title="Vytvořit nový odkaz">Nový odkaz</button>
					</form>
				</li>
			</ul>
			<div class="card-footer bg-transparent small text-body-secondary">
				Odkaz je osobní a platí {App\Model\Access\AccessFacade::ValidityDays} dní po zasedání. Nový odkaz zruší předchozí.
			</div>
		</div>
	</div>
</div>
