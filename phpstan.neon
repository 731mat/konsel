parameters:
	level: max
	paths:
		- app
		- bin/console
		- migrations
		- tests
		- www
	tmpDir: temp/phpstan
	checkMissingCallableSignature: true
	reportUnmatchedIgnoredErrors: true
	fileExtensions:
		- php
		- phpt
	ignoreErrors:
		-
			identifier: method.deprecated
			path: app/Core/Doctrine/MigrationsTableSchemaSubscriber.php
		-
			identifier: classConstant.deprecated
			path: app/Core/Doctrine/MigrationsTableSchemaSubscriber.php
	doctrine:
		objectManagerLoader: tests/Support/phpstan-object-manager.php
