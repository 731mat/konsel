<IfModule mod_rewrite.c>
	RewriteEngine On

	# soubory začínající tečkou nejsou veřejné
	RewriteRule /\.|^\.(?!well-known/) - [F]

	# front controller
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule !\.(pdf|js|mjs|ico|gif|jpg|jpeg|png|webp|svg|css|map|eot|ttf|otf|woff|woff2)$ index.php [L]
</IfModule>
