{
    "name": "matyho/konsel",
    "description": "Konšel – systém pro přípravu a vedení zasedání zastupitelstva a rady obce",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "contributte/console": "^0.11.0",
        "latte/latte": "^3.1",
        "nette/application": "^3.3",
        "nette/bootstrap": "^3.3",
        "nette/caching": "^4.0",
        "nette/di": "^3.2",
        "nette/forms": "^3.3",
        "nette/http": "^3.4",
        "nette/mail": "^4.2",
        "nette/security": "^3.2",
        "nette/utils": "^4.1",
        "nettrine/dbal": "^0.10.3",
        "nettrine/migrations": "^0.10.1",
        "nettrine/orm": "^0.10.1",
        "symfony/cache": "^8.1",
        "symfony/clock": "^8.1",
        "tracy/tracy": "^2.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "require-dev": {
        "nette/tester": "^2.7",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-nette": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.1",
        "symplify/easy-coding-standard": "^13.3"
    },
    "scripts": {
        "cs": "ecs check",
        "cs-fix": "ecs check --fix",
        "stan": "phpstan analyse --memory-limit=1G",
        "test": "tester tests -C -s --colors 1",
        "qa": [
            "@cs",
            "@stan",
            "@test"
        ],
        "db:reset": [
            "@php -r \"array_map('unlink', glob('var/database.sqlite*') ?: []);\"",
            "@php bin/console migrations:migrate --no-interaction --allow-no-migration"
        ]
    },
    "scripts-descriptions": {
        "cs": "Kontrola coding standardu",
        "cs-fix": "Oprava coding standardu",
        "stan": "Statická analýza PHPStan",
        "test": "Testy (Nette Tester)",
        "qa": "Kompletní brána kvality",
        "db:reset": "Smaže DB, spustí migrace a nahraje demo data"
    }
}
