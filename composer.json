{
	"name": "matyho/konsel",
	"description": "Konšel – systém pro přípravu a vedení zasedání zastupitelstva a rady obce",
	"type": "project",
	"license": "proprietary",
	"require": {
		"php": ">=8.4",
		"latte/latte": "^3.1",
		"nette/application": "^3.3",
		"nette/bootstrap": "^3.3",
		"nette/caching": "^4.0",
		"nette/di": "^3.2",
		"nette/forms": "^3.3",
		"nette/http": "^3.4",
		"nette/mail": "^4.2",
		"nette/security": "^3.2",
		"nette/utils": "^4.1",
		"tracy/tracy": "^2.12"
	},
	"autoload": {
		"psr-4": {
			"App\\": "app/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tests\\": "tests/"
		}
	},
	"config": {
		"sort-packages": true,
		"optimize-autoloader": true
	},
	"minimum-stability": "stable"
}
