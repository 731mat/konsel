<?php

declare(strict_types=1);

use App\Model\Attachment\AttachmentFacade;
use App\Model\Document\MeetingDocumentFacade;
use App\Model\Document\MeetingDocumentType;
use App\Model\Meeting\AgendaFacade;
use App\Model\Meeting\Command\SaveAgendaItem;
use App\Model\Meeting\MeetingFacade;
use App\Model\People\Command\AddMember;
use App\Model\People\Command\SavePerson;
use App\Model\People\MemberFunction;
use App\Model\People\PeopleFacade;
use App\Model\Storage\UploadedFile;
use Tester\Assert;
use Tests\Support\ContainerFactory;
use Tests\Support\MeetingScenario;
use Tests\Support\TestDatabase;

require __DIR__ . '/../../../bootstrap.php';

/**
 * @return array{MeetingDocumentFacade, MeetingScenario, Nette\DI\Container}
 */
function bootDocuments(): array
{
	$container = ContainerFactory::create();
	TestDatabase::migrate($container);
	$scenario = MeetingScenario::create($container);
	$people = $container->getByType(PeopleFacade::class);
	$mayor = $people->createPerson($scenario->municipality->getId(), new SavePerson('Jan', 'Dvořák', 'Ing.'));
	$people->addMember($scenario->meeting->getBody()->getId(), new AddMember($mayor->getId(), MemberFunction::Mayor, new DateTimeImmutable('2026-10-21')));
	$agenda = $container->getByType(AgendaFacade::class);
	$agenda->updateItem($scenario->item->getId(), new SaveAgendaItem('Rozpočet na rok 2027', "Návrh byl zveřejněn.\n\nJe vyrovnaný.", 'Zastupitelstvo schvaluje rozpočet.'));
	$agenda->insertStandardItems($scenario->meeting->getId());

	return [$container->getByType(MeetingDocumentFacade::class), $scenario, $container];
}

test('invitation contains legal notice, date, place, program and mayor', function (): void {
	[$facade, $scenario, $container] = bootDocuments();
	$meeting = $container->getByType(MeetingFacade::class)->get($scenario->meeting->getId());

	$html = $facade->renderHtml($meeting, MeetingDocumentType::Invitation);

	Assert::contains('§ 93 odst. 1 zákona č. 128/2000 Sb.', $html);
	Assert::contains('1. zasedání Zastupitelstva obce Neplachovice', $html);
	Assert::contains('středa 9. prosince 2026 v 18:00 hodin', $html);
	Assert::contains('<li>Rozpočet na rok 2027</li>', $html);
	Assert::contains('Ing. Jan Dvořák', $html);
	Assert::contains('Vyvěšeno na úřední desce', $html);
});

test('materials list descriptions, resolutions and public attachments', function (): void {
	[$facade, $scenario, $container] = bootDocuments();
	$stream = fopen('php://memory', 'w+b');
	assert($stream !== false);
	fwrite($stream, '%PDF');
	rewind($stream);
	$attachments = $container->getByType(AttachmentFacade::class);
	$attachments->upload($scenario->item->getId(), [new UploadedFile($stream, 'rozpočet.pdf')], null);
	$meeting = $container->getByType(MeetingFacade::class)->get($scenario->meeting->getId());

	$html = $facade->renderHtml($meeting, MeetingDocumentType::Materials);

	Assert::contains('<p>Návrh byl zveřejněn.</p><p>Je vyrovnaný.</p>', $html);
	Assert::contains('Zastupitelstvo schvaluje rozpočet.', $html);
	Assert::contains('rozpočet.pdf', $html);
});

test('PDF is generated by mPDF', function (): void {
	[$facade, $scenario] = bootDocuments();

	$document = $facade->generate($scenario->meeting->getId(), MeetingDocumentType::Invitation);

	Assert::same('pozvanka-1-zasedani-2026-12-09.pdf', $document->fileName);
	Assert::same('%PDF-', substr($document->content, 0, 5));
	Assert::true(strlen($document->content) > 5000);
});
