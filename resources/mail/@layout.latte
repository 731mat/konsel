{* Společný vzhled e-mailů: tabulkové rozložení a inline styly (e-mailoví klienti neumí moderní CSS).
   Barvy $brand, $onBrand a $accent jsou ověřené #rrggbb (HexColor) – v atributu style se proto vypisují bez escapování. *}
{varType App\Model\Municipality\Municipality $municipality}
{varType App\Model\Municipality\MunicipalityProfile $profile}
{varType string $brand}
{varType string $accent}
<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{block title}{/block}</title>
</head>
<body style="margin:0; padding:0; background:#f3f5f8; font-family:Arial, Helvetica, sans-serif; color:#1f2937;">
	<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3f5f8; padding:24px 12px;">
		<tr>
			<td align="center">
				<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px; background:#ffffff; border-radius:8px; overflow:hidden; border-top:4px solid {$accent|noescape};">
					<tr>
						<td style="padding:20px 28px; border-bottom:1px solid #e3e8ef;">
							<div style="font-size:13px; color:#64748b;">{$profile->officialName}</div>
						</td>
					</tr>
					<tr>
						<td style="padding:24px 28px; font-size:15px; line-height:1.55;">
							{include content}
						</td>
					</tr>
					<tr>
						<td style="padding:16px 28px; background:#f8fafc; font-size:12px; line-height:1.5; color:#64748b;">
							{$profile->officialName}{if $profile->getAddressLine()} · {$profile->getAddressLine()}{/if}{if $profile->phone} · tel. {$profile->phone}{/if}{if $profile->email} · {$profile->email->value}{/if}<br>
							Odesláno systémem Konšel.
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
</body>
</html>

{define button, string $url, string $label}
	<table role="presentation" cellpadding="0" cellspacing="0" style="margin:20px 0;">
		<tr>
			<td bgcolor="{$brand}" style="border-radius:6px; background:{$brand|noescape};">
				<a href="{$url}" style="display:inline-block; padding:12px 22px; font-weight:bold; font-size:15px; color:{$onBrand|noescape}; text-decoration:none;">{$label}</a>
			</td>
		</tr>
	</table>
{/define}
